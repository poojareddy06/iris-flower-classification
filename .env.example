# ===================================================================
# Iris ML Platform Environment Variables
# ===================================================================

# Database Connection (Defaults to local SQLite if left blank; PostgreSQL supported)
DATABASE_URL=sqlite:///./iris_app.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/iris_db

# Security & Session Authentication
SECRET_KEY=iris-ml-secret-key-decision-tree-2026-pooja-v

# Optional External AI API Key (One optional key)
# If omitted, application uses the intelligent built-in botanical ML knowledge engine
AI_API_KEY=
GEMINI_API_KEY=

# Server Configuration
PORT=8000
HOST=127.0.0.1
